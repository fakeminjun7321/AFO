{
  "name": "afo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "preview": "node dist/apps/cli/src/index.js preview",
    "rules:suggest": "node dist/apps/cli/src/index.js suggest-rules",
    "rules:confirm": "node dist/apps/cli/src/index.js confirm-rules"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "5.9.3" }
}
