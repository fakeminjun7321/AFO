rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function clean(value) { return value.matches('^[^\\x00-\\x1F\\x7F]*$'); }
    function label(value) {
      return value is string && value.size() > 0 && value.size() <= 80
        && value.matches('^[^/\\\\:]+$') && clean(value);
    }
    function relativeDirectory(value) {
      return value is string && value.size() > 0 && value.size() <= 512 && clean(value)
        && value.matches('^[^/\\\\:<>"|?*]+(/[^/\\\\:<>"|?*]+)*$')
        && !value.matches('(.*/)?\\.\\.?(/.*)?')
        && !value.matches('.*[. ](/.*)?')
        && !value.matches('(?i)(.*/)?(con|prn|aux|nul|com[1-9]|lpt[1-9])(\\.[^/]*)?(/.*)?');
    }
    function rule(value) {
      return value is map
        && value.keys().hasAll(['id', 'extension', 'keyword', 'targetDirectory', 'enabled', 'revision', 'updatedAt'])
        && value.keys().hasOnly(['id', 'extension', 'keyword', 'targetDirectory', 'enabled', 'revision', 'updatedAt'])
        && value.id is string && value.id.matches('^[A-Za-z0-9_-]{1,64}$')
        && value.extension is string && value.extension.matches('^\\.[a-z0-9]{1,16}$')
        && (value.keyword == null || label(value.keyword))
        && relativeDirectory(value.targetDirectory) && value.enabled is bool
        && value.revision is int && value.revision > 0 && value.updatedAt == request.time;
    }
    function ids(values) {
      return values is list && values.size() <= 20 && values.toSet().size() == values.size()
        && (values.size() <= 0 || (values[0] is string && values[0].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 1 || (values[1] is string && values[1].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 2 || (values[2] is string && values[2].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 3 || (values[3] is string && values[3].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 4 || (values[4] is string && values[4].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 5 || (values[5] is string && values[5].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 6 || (values[6] is string && values[6].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 7 || (values[7] is string && values[7].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 8 || (values[8] is string && values[8].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 9 || (values[9] is string && values[9].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 10 || (values[10] is string && values[10].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 11 || (values[11] is string && values[11].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 12 || (values[12] is string && values[12].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 13 || (values[13] is string && values[13].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 14 || (values[14] is string && values[14].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 15 || (values[15] is string && values[15].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 16 || (values[16] is string && values[16].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 17 || (values[17] is string && values[17].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 18 || (values[18] is string && values[18].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (values.size() <= 19 || (values[19] is string && values[19].matches('^[A-Za-z0-9_-]{1,64}$')));
    }
    function record(value) {
      return value.keys().hasAll(['formatVersion', 'revision', 'name', 'ruleIds', 'updatedAt'])
        && value.keys().hasOnly(['formatVersion', 'revision', 'name', 'ruleIds', 'updatedAt'])
        && value.formatVersion == 1 && value.revision is int && value.revision > 0
        && label(value.name) && ids(value.ruleIds)
        && value.updatedAt is timestamp && value.updatedAt == request.time;
    }
    function parentStep(uid, ruleSetId, ruleId) {
      let p = /databases/$(database)/documents/users/$(uid)/ruleSets/$(ruleSetId);
      let after = getAfter(p).data;
      return ruleId in after.ruleIds && request.resource.data.revision == after.revision
        && ((!exists(p) && after.revision == 1) || (exists(p) && after.revision == get(p).data.revision + 1));
    }
    match /users/{uid}/ruleSets/{ruleSetId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && ruleSetId.matches('^[A-Za-z0-9_-]{1,64}$')
        && record(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(uid) && record(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner(uid);
      match /rules/{ruleId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.id == ruleId
          && rule(request.resource.data) && parentStep(uid, ruleSetId, ruleId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
